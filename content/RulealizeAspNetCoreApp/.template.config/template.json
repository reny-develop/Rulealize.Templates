{
  "$schema": "http://json.schemastore.org/template",
  "author": "Reny",
  "classifications": [ "Rulealize", "Web", "ASP.NET Core", "Blazor" ],
  "identity": "Rulealize.AspNetCore.App.Template",
  "name": "Rulealize application for ASP.NET Core",
  "description": "An ASP.NET Core application made of rule sets and Razor screens, before either is written: no screen, no rule set, and an entry point that is one call.",
  "shortName": "rulealize-aspnetcore-app",
  "defaultName": "RulealizeApp",
  "sourceName": "Rulealize.AspNetCore.Example",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "feed": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "replaces": "FEED_FOLDER",
      "description": "A folder of packages to restore from besides nuget.org, written into a nuget.config. For RulealizeStudio.AspNetCore's packages while they are not on nuget.org; without it, no nuget.config is written."
    },
    "hasFeed": {
      "type": "computed",
      "value": "(feed != \"\")"
    },
    "port": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "low": 5000,
        "high": 5300
      },
      "replaces": "5199"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [ "**/bin/**", "**/obj/**" ]
        },
        {
          "condition": "(!hasFeed)",
          "exclude": [ "nuget.config" ]
        }
      ]
    }
  ]
}

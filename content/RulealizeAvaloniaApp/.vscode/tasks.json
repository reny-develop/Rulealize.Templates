{
  // Two of the tools AGENTS.md names, as tasks, so that what they report is in the Problems panel
  // for whoever runs them: whether the design builds against the rules, and whether the screen does
  // what the test design says. What the others report the Rulealize extension shows as it changes.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": [ "build" ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "replay the test design",
      "type": "process",
      "command": "dotnet",
      "args": [ "rulealize-studio", "replay" ],
      "dependsOn": "build",
      "group": "test",
      "problemMatcher": "$msCompile"
    }
  ]
}
